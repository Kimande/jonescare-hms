generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model ai_insights {
  id         Int      @id @default(autoincrement())
  type       String   @db.VarChar(60)
  period     String   @db.VarChar(40)
  summary    String   @db.Text
  source     String   @default("AGENTIC_AI") @db.VarChar(60)
  created_at DateTime @default(now()) @db.DateTime(0)

  @@index([type, period], map: "idx_ai_insights")
}

model appointments {
  id         Int                 @id @default(autoincrement())
  patient_id Int
  doctor_id  Int
  date_time  DateTime            @db.DateTime(0)
  status     appointments_status @default(BOOKED)
  reason     String?             @db.VarChar(255)
  created_at DateTime            @default(now()) @db.DateTime(0)
  users      users               @relation(fields: [doctor_id], references: [id], onUpdate: Restrict, map: "fk_appt_doctor")
  patients   patients            @relation(fields: [patient_id], references: [id], onUpdate: Restrict, map: "fk_appt_patient")
  visits     visits?

  @@index([patient_id], map: "fk_appt_patient")
  @@index([doctor_id, date_time], map: "idx_appt_doctor_time")
}

model audit_logs {
  id         BigInt   @id @default(autoincrement())
  user_id    Int
  action     String   @db.VarChar(60)
  table_name String   @db.VarChar(60)
  record_id  Int?
  timestamp  DateTime @default(now()) @db.DateTime(0)
  users      users    @relation(fields: [user_id], references: [id], onUpdate: Restrict, map: "fk_audit_user")

  @@index([table_name, record_id], map: "idx_audit_table")
  @@index([user_id], map: "idx_audit_user")
}

model bill_items {
  id        Int                  @id @default(autoincrement())
  bill_id   Int
  item_type bill_items_item_type
  item_id   Int
  quantity  Int                  @default(1)
  price     Decimal              @db.Decimal(10, 2)
  bills     bills                @relation(fields: [bill_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_billitems_bill")

  @@index([bill_id], map: "fk_billitems_bill")
}

model bills {
  id         Int              @id @default(autoincrement())
  visit_id   Int              @unique(map: "uq_bills_visit")
  total      Decimal          @default(0.00) @db.Decimal(10, 2)
  status     bills_status     @default(UNPAID)
  payer_type bills_payer_type @default(SELF)
  created_at DateTime         @default(now()) @db.DateTime(0)
  updated_at DateTime         @default(now()) @db.DateTime(0)
  bill_items bill_items[]
  visits     visits           @relation(fields: [visit_id], references: [id], onUpdate: Restrict, map: "fk_bills_visit")
  payments   payments[]
}

model drugs {
  id            Int             @id @default(autoincrement())
  name          String          @unique(map: "uq_drugs_name") @db.VarChar(120)
  price         Decimal         @db.Decimal(10, 2)
  stock_qty     Int             @default(0)
  reorder_level Int             @default(10)
  prescriptions prescriptions[]
}

model integration_logs {
  id             BigInt                     @id @default(autoincrement())
  integration_id Int
  direction      integration_logs_direction
  endpoint       String                     @db.VarChar(255)
  status_code    Int?
  payload        String?                    @db.LongText
  response       String?                    @db.LongText
  error          String?                    @db.Text
  created_at     DateTime                   @default(now()) @db.DateTime(0)
  integrations   integrations               @relation(fields: [integration_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_intlogs_integration")

  @@index([integration_id, created_at], map: "idx_intlogs")
}

model integrations {
  id               Int                 @id @default(autoincrement())
  name             String              @unique(map: "uq_integrations_name") @db.VarChar(60)
  base_url         String?             @db.VarChar(255)
  status           integrations_status @default(DISABLED)
  config           String?             @db.LongText
  created_at       DateTime            @default(now()) @db.DateTime(0)
  updated_at       DateTime            @default(now()) @db.DateTime(0)
  integration_logs integration_logs[]
}

model lab_requests {
  id            Int                 @id @default(autoincrement())
  visit_id      Int
  test_name     String              @db.VarChar(120)
  status        lab_requests_status @default(PENDING)
  result        String?             @db.Text
  technician_id Int?
  created_at    DateTime            @default(now()) @db.DateTime(0)
  updated_at    DateTime            @default(now()) @db.DateTime(0)
  users         users?              @relation(fields: [technician_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_lab_tech")
  visits        visits              @relation(fields: [visit_id], references: [id], onUpdate: Restrict, map: "fk_lab_visit")

  @@index([technician_id], map: "fk_lab_tech")
  @@index([visit_id], map: "fk_lab_visit")
}

model patients {
  id           Int             @id @default(autoincrement())
  patient_no   String          @unique(map: "uq_patients_no") @db.VarChar(20)
  name         String          @db.VarChar(120)
  dob          DateTime        @db.Date
  gender       patients_gender
  phone        String          @db.VarChar(20)
  national_id  String?         @db.VarChar(20)
  county       String?         @db.VarChar(60)
  town         String?         @db.VarChar(60)
  address      String?         @db.VarChar(255)
  sha_number   String?         @db.VarChar(40)
  user_id      Int?            @unique(map: "uq_patients_user")
  created_at   DateTime        @default(now()) @db.DateTime(0)
  updated_at   DateTime        @default(now()) @db.DateTime(0)
  appointments appointments[]
  users        users?          @relation(fields: [user_id], references: [id], onUpdate: Restrict, map: "fk_patients_user")
  visits       visits[]

  @@index([county], map: "idx_patients_county")
  @@index([name], map: "idx_patients_name")
  @@index([phone], map: "idx_patients_phone")
}

model payments {
  id          Int             @id @default(autoincrement())
  bill_id     Int
  method      payments_method
  amount      Decimal         @db.Decimal(10, 2)
  reference   String?         @db.VarChar(80)
  received_by Int
  created_at  DateTime        @default(now()) @db.DateTime(0)
  bills       bills           @relation(fields: [bill_id], references: [id], onUpdate: Restrict, map: "fk_pay_bill")
  users       users           @relation(fields: [received_by], references: [id], onUpdate: Restrict, map: "fk_pay_receiver")

  @@index([bill_id], map: "fk_pay_bill")
  @@index([received_by], map: "fk_pay_receiver")
}

model prescriptions {
  id         Int                  @id @default(autoincrement())
  visit_id   Int
  drug_id    Int
  dosage     String               @db.VarChar(120)
  quantity   Int
  status     prescriptions_status @default(PENDING)
  created_at DateTime             @default(now()) @db.DateTime(0)
  drugs      drugs                @relation(fields: [drug_id], references: [id], onUpdate: Restrict, map: "fk_presc_drug")
  visits     visits               @relation(fields: [visit_id], references: [id], onUpdate: Restrict, map: "fk_presc_visit")

  @@index([drug_id], map: "fk_presc_drug")
  @@index([visit_id], map: "fk_presc_visit")
}

model services {
  id    Int     @id @default(autoincrement())
  name  String  @unique(map: "uq_services_name") @db.VarChar(120)
  price Decimal @db.Decimal(10, 2)
}

model users {
  id            Int            @id @default(autoincrement())
  name          String         @db.VarChar(120)
  email         String         @unique(map: "uq_users_email") @db.VarChar(160)
  phone         String         @db.VarChar(20)
  gender        users_gender
  license_no    String?        @unique(map: "uq_users_license") @db.VarChar(60)
  password_hash String         @db.VarChar(255)
  role          users_role
  status        users_status   @default(ACTIVE)
  created_at    DateTime       @default(now()) @db.DateTime(0)
  updated_at    DateTime       @default(now()) @db.DateTime(0)
  appointments  appointments[]
  audit_logs    audit_logs[]
  lab_requests  lab_requests[]
  patients      patients?
  payments      payments[]
  visits        visits[]

  @@index([role], map: "idx_users_role")
}

model visits {
  id             Int             @id @default(autoincrement())
  patient_id     Int
  doctor_id      Int?
  appointment_id Int?            @unique(map: "uq_visits_appt")
  vitals         String?         @db.LongText
  diagnosis      String?         @db.Text
  notes          String?         @db.Text
  status         visits_status   @default(WAITING)
  created_at     DateTime        @default(now()) @db.DateTime(0)
  updated_at     DateTime        @default(now()) @db.DateTime(0)
  bills          bills?
  lab_requests   lab_requests[]
  prescriptions  prescriptions[]
  appointments   appointments?   @relation(fields: [appointment_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_visits_appt")
  users          users?          @relation(fields: [doctor_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_visits_doctor")
  patients       patients        @relation(fields: [patient_id], references: [id], onUpdate: Restrict, map: "fk_visits_patient")

  @@index([doctor_id], map: "fk_visits_doctor")
  @@index([patient_id], map: "idx_visits_patient")
  @@index([status], map: "idx_visits_status")
}

enum bill_items_item_type {
  SERVICE
  DRUG
}

enum integration_logs_direction {
  OUTBOUND
  INBOUND
}

enum payments_method {
  CASH
  MPESA
  CARD
  INSURANCE
  OTHER
}

enum bills_status {
  UNPAID
  PARTIAL
  PAID
  ARCHIVED
}

enum integrations_status {
  DISABLED
  ENABLED
  ERROR
}

enum lab_requests_status {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum appointments_status {
  BOOKED
  RESCHEDULED
  CANCELLED
  COMPLETED
}

enum bills_payer_type {
  SELF
  INSURANCE
  OTHER
}

enum patients_gender {
  MALE
  FEMALE
  OTHER
}

enum users_gender {
  MALE
  FEMALE
  OTHER
}

enum prescriptions_status {
  PENDING
  DISPENSED
  CANCELLED
}

enum users_role {
  ADMIN
  RECEPTIONIST
  DOCTOR
  NURSE
  LAB_TECH
  PHARMACIST
  PATIENT
}

enum visits_status {
  WAITING
  IN_CONSULTATION
  COMPLETED
}

enum users_status {
  ACTIVE
  INACTIVE
}
